  Redirect 301 /artikelen/een-cursus-als-uitbreiding/ https://burovaders.nl/
  Redirect 301 /artikelen/het-gebruik-van-facebook-groepen/ https://burovaders.nl/
  Redirect 301 /artikelen/het-opzetten-van-een-marketingplan/ https://burovaders.nl/
