  Redirect 301 /artikelen/wordt-gevonden-in-google/ https://burovaders.nl/
  Redirect 301 /artikelen/zelf-een-website-bouwen-of-uitbesteden/ https://burovaders.nl/
  Redirect 301 /betaalde-advertenties-op-facebook-en-instagram/ https://burovaders.nl/
