# ==========================================================
#  wesleyvaders.nl
#  Astro levert statische HTML. Dit bestand doet drie dingen:
#  1. de oude therapeuten-URL's doorsturen naar burovaders.nl
#  2. compressie en caching
#  3. een paar beveiligingsheaders
# ==========================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
</IfModule>

# ---------- 1 · Oude site ----------
# Alle content over webdesign voor therapeuten is weg. Die hoort
# bij het bedrijf, niet bij dit verhaal. Alles gaat daarom naar de
# homepage van burovaders.nl.
#
# LET OP: /, /contact/, /cookies/ en /privacy-policy/ staan hier
# BEWUST NIET tussen. Die paden bestaan op de nieuwe site en zouden
# anders onbereikbaar worden. Voeg hier nooit een regel toe die met
# een bestaand pad van deze site botst.

<IfModule mod_alias.c>
  Redirect 301 /algemene-voorwaarden/ https://burovaders.nl/
  Redirect 301 /artikelen/ https://burovaders.nl/
  Redirect 301 /artikelen/bloggen-voor-coaches-en-therapeuten/ https://burovaders.nl/
  Redirect 301 /artikelen/de-belangrijkste-elementen-van-een-website/ https://burovaders.nl/
