# ==========================================================
#  wesleyvaders.nl
#  Astro levert statische HTML. Dit bestand doet drie dingen:
#  1. de oude therapeuten-URL's doorsturen naar burovaders.nl
#  2. compressie en caching
#  3. een paar beveiligingsheaders
# ==========================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
</IfModule>

# ---------- 1 · Oude site ----------
# Alle content over webdesign voor therapeuten is weg. Die hoort
# bij het bedrijf, niet bij dit verhaal.
#
# Die URL's krijgen een 410 en geen redirect naar de homepage van
# burovaders.nl. Google leest een redirect naar een pagina die er niet
# over gaat als een zachte 404: dan blijven ze in de index hangen en
# gaat er geen waarde heen. 410 zegt: weg, verwijderen.
#
# ErrorDocument hieronder laat er wel een nette pagina bij zien, zodat
# iemand die op een oude link klikt niet in het niets staat. De status
# blijft 410; die pagina staat op noindex en niet in de sitemap.
#
# Eén uitzondering: /algemene-voorwaarden/ heeft wél een echte
# opvolger op burovaders.nl en houdt dus een gewone 301.
#
# LET OP: /, /contact/, /cookies/ en /privacy-policy/ staan hier
# BEWUST NIET tussen. Die paden bestaan op de nieuwe site en zouden
# anders onbereikbaar worden. Voeg hier nooit een regel toe die met
# een bestaand pad van deze site botst.

<IfModule mod_alias.c>
  ErrorDocument 410 /weg/index.html

  Redirect 301 /algemene-voorwaarden/ https://burovaders.nl/algemene-voorwaarden.html

  Redirect 410 /artikelen/
  Redirect 410 /artikelen/bloggen-voor-coaches-en-therapeuten/
  Redirect 410 /artikelen/de-belangrijkste-elementen-van-een-website/
  Redirect 410 /artikelen/e-mailmarketing/
  Redirect 410 /artikelen/een-cursus-als-uitbreiding/
  Redirect 410 /artikelen/het-gebruik-van-facebook-groepen/
  Redirect 410 /artikelen/het-opzetten-van-een-marketingplan/
  Redirect 410 /artikelen/hoe-je-een-e-book-of-cursus-ontwikkelt/
  Redirect 410 /artikelen/hoe-maak-je-effectieve-videos/
  Redirect 410 /artikelen/jouw-energie-online-uitstralen/
  Redirect 410 /artikelen/jouw-ideale-niche-en-doelgroep/
  Redirect 410 /artikelen/logos-en-kleurenschemas/
  Redirect 410 /artikelen/marketing-funnels/
  Redirect 410 /artikelen/podcasten/
  Redirect 410 /artikelen/social-media-voor-je-praktijk-of-onderneming/
  Redirect 410 /artikelen/tips-voor-groei-op-instagram/
  Redirect 410 /artikelen/waarom-een-goede-website-essentieel-is/
  Redirect 410 /artikelen/wat-is-mindful-marketing/
  Redirect 410 /artikelen/wordt-gevonden-in-google/
  Redirect 410 /artikelen/zelf-een-website-bouwen-of-uitbesteden/
  Redirect 410 /betaalde-advertenties-op-facebook-en-instagram/
  Redirect 410 /blog-op-je-website/
  Redirect 410 /contentstrategie/
  Redirect 410 /de-5-belangrijkste-elementen-van-een-website/
  Redirect 410 /de-basis-van-branding/
  Redirect 410 /de-kracht-van-een-goed-verhaal/
  Redirect 410 /de-kracht-van-linkedin/
  Redirect 410 /de-kracht-van-reviews/
  Redirect 410 /e-maillijst/
  Redirect 410 /eenvoudige-seo-tips/
  Redirect 410 /gratis-e-book/
  Redirect 410 /hashtags-en-algoritmes/
  Redirect 410 /hoe-creeer-je-een-visuele-stijl/
  Redirect 410 /hoe-gebruik-je-storytelling/
  Redirect 410 /hoe-ontdek-je-jouw-unieke-niche-en-ideale-klant/
  Redirect 410 /hoe-schrijf-je-blogs/
  Redirect 410 /hoe-schrijf-je-een-over-mij-pagina/
  Redirect 410 /hoe-schrijf-je-teksten/
  Redirect 410 /instagram-stories-en-reels/
  Redirect 410 /je-eerste-e-book/
  Redirect 410 /nieuwsbrief/
  Redirect 410 /online-zichtbaarheid-voor-therapeuten-en-coaches/
  Redirect 410 /onweerstaanbare-aanbiedingen/
  Redirect 410 /over-mij/
  Redirect 410 /project/centrum-heelheid-een-nieuwe-online-basis-voor-opleidingen/
  Redirect 410 /project/therapienuante-nl-therapie-die-je-verbindt-met-je-ware-zelf/
  Redirect 410 /project/zen-ja-hypnotherapeut-mindfulness-trainer/
  Redirect 410 /samenwerking/
  Redirect 410 /seo-voor-gevorderden/
  Redirect 410 /social-media-content/
  Redirect 410 /veelgemaakte-fouten-op-websites/
  Redirect 410 /video-voor-online-zichtbaarheid/
  Redirect 410 /waarom-consistentie-op-social-media-de-sleutel-is-tot-succes/
  Redirect 410 /waarom-een-nieuwsbrief-belangrijk-is/
  Redirect 410 /website-sneller/
  Redirect 410 /websites-voor-therapeuten/
  Redirect 410 /welke-social-media-platformen-werken-het-beste/

  # Eigen verhalen die van URL zijn veranderd
  Redirect 301 /verhalen/2026-08-26-mijn-bed-gaat-naar-rijswijk/ https://wesleyvaders.nl/verhalen/2026-08-25-mijn-bed-gaat-naar-rijswijk/

  # /hierennu/ is weggehaald op 18 oktober 2026. De korte berichten
  # kwamen er niet meer van en de wekelijkse verhalen doen dat werk nu.
  # De tekst staat in bewaard/hierennu-zeven-berichten.md. Ook de
  # genummerde pagina's doorsturen, die stonden in de sitemap.
  RedirectMatch 301 ^/hierennu(/.*)?$ https://wesleyvaders.nl/verhalen/

  # /route/ is weggehaald op 1 oktober 2026. Die pagina beschreef de
  # mooie weg langs Mont-Saint-Michel en de Bardenas; de bus is over de
  # snelweg gegaan. De URL stond in de sitemap en is gedeeld, dus geen
  # 404. De tekst staat in bewaard/route-zeven-etappes.md.
  # Dit verhaal wees naar /route/ en gaat nu rechtstreeks door, anders
  # staan er twee redirects achter elkaar.
  Redirect 301 /verhalen/2026-08-30-niet-de-snelste-weg/ https://wesleyvaders.nl/verhalen/
  Redirect 301 /route/ https://wesleyvaders.nl/verhalen/
</IfModule>

# ---------- 2 · Compressie ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json image/svg+xml
</IfModule>

# ---------- 3 · Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# ---------- 4 · Headers ----------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"

  # HTML en versie.txt mogen nooit verouderd worden uitgeleverd.
  #
  # no-cache betekent niet "niet bewaren" maar "altijd even navragen":
  # de browser houdt de kopie, vraagt bij elk bezoek of hij nog klopt en
  # krijgt een 304 als er niets veranderd is. Dus geen oude pagina's meer
  # en bijna geen snelheidsverlies, want bij een 304 komt er geen inhoud
  # overheen.
  #
  # HTML stond hiervoor op tien minuten via mod_expires. Daardoor zag je
  # na een deploy nog de oude homepage terwijl de upload gelukt was.
  # versie.txt had helemaal geen regel, en dan mag een cache zelf een
  # houdbaarheid verzinnen; ook die liep daardoor achter. Dat bestand is
  # juist de snelle waarheid over wat er live staat.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
  <FilesMatch "^versie\.txt$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
</IfModule>

# ---------- 5 · Nette 404 ----------
ErrorDocument 404 /404.html
