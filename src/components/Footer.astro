---
import Merkteken from './Merkteken.astro';
import { site, nav, socials } from '../data/site.js';
---
<footer>
  <svg class="ridge" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 120 L0 74 L96 52 L188 78 L286 34 L392 66 L512 22 L618 58 L742 30 L858 70 L978 40 L1104 66 L1228 38 L1340 62 L1440 44 L1440 120 Z"
      fill="#243B2F" />
    <path d="M0 120 L0 96 L120 82 L240 100 L360 74 L480 96 L620 70 L760 92 L900 76 L1040 98 L1180 80 L1320 96 L1440 82 L1440 120 Z"
      fill="#1F3328" />
  </svg>
  <div class="wrap">
    <div class="ftop">
      <div>
        <div class="brand">
          <Merkteken size={30} />
          <span class="wm">{site.naam}<small>{site.serie}</small></span>
        </div>
        <p class="ftag">{site.slotzin[0]}<br />{site.slotzin[1]}</p>
      </div>
      <div class="fcol">
        <h4>De reis</h4>
        {nav.map(i => <a href={i.href}>{i.titel}</a>)}
      </div>
      <div class="fcol">
        <h4>Onderweg</h4>
        {socials.map(s => <a href={s.href} rel="noopener">{s.naam}</a>)}
      </div>
    </div>
    <div class="fbot mono">
      <span>&copy; {new Date().getFullYear()} {site.naam}</span>
      <span><a href="/privacy-policy/">Privacy</a> &middot; <a href="/cookies/">Cookies</a> &middot; <a href="/contact/">Contact</a></span>
    </div>
  </div>
</footer>
