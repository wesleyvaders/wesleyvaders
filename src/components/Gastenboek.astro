---
import { vertrek, aankomst } from '../data/site.js';
import { haalGastenboek } from '../lib/gastenboek.js';
import { dagenTot, fase, kies } from '../lib/tijd.js';

const dagen = dagenTot(vertrek);
const f = fase(vertrek, aankomst);

// De zichtbare tekst en de meta-omschrijving van /gastenboek/ komen uit
// dezelfde fase. Liepen uiteen: de meta zei al "nu ik in Spanje zit"
// terwijl hier nog "ik ben onderweg naar het zuiden" stond.
const kop = kies(f, {
  aftellen: 'Voordat ik ga',
  onderweg: 'Onderweg',
  aangekomen: 'Nu ik hier zit'
});
const intro = kies(f, {
  aftellen: null,   // die zin telt de dagen af en staat hieronder apart
  onderweg: 'Ik ben onderweg naar het zuiden. Wil je iets kwijt, dan kan dat hier. Ik lees alles.',
  aangekomen: 'Ik zit in Spanje. Wil je iets kwijt, dan kan dat hier. Ik lees alles.'
});

const suggesties = [
  'Een herinnering',
  kies(f, {
    aftellen: 'Een goede raad voor onderweg',
    onderweg: 'Een goede raad voor onderweg',
    aangekomen: 'Een goede raad'
  }),
  'Iets wat ik in Spanje moet doen'
];

const MAX = 3000;

// Hoeveel berichten er onder het blok komen te staan. Op /gastenboek/
// alle, in stappen van tien met een knop eronder. Op de homepage maar
// een handvol: daar gaat het over de reis, en 46 berichten in hun
// geheel — waarvan eentje van tien alinea's — maakten dat blok het
// zwaartepunt van de pagina. De link naar /gastenboek/ is daar de route
// naar de rest.
const { toon = null } = Astro.props;

// één bericht uitgelicht. Bij de build kiezen we er alvast een, zodat er
// meteen iets staat; de browser wisselt hem daarna bij elke weergave.
const gastenboek = await haalGastenboek();
const uitgelicht = gastenboek?.berichten?.length
  ? gastenboek.berichten[Math.floor(Math.random() * gastenboek.berichten.length)]
  : null;
const fmtNL = (iso) => {
  const d = new Date(iso);
  return isNaN(d) ? '' : new Intl.DateTimeFormat('nl-NL',
    { day: '2-digit', month: '2-digit', year: 'numeric' }).format(d).replaceAll('-', '.');
};
---
<section class="sec" id="gastenboek" data-toon={toon ?? undefined}>
  <div class="grain"></div>
  <div class="wrap">
    <div class="grid2 g-gb rv">
      <div class="gb-links">
        <p class="eyebrow">Laat iets achter</p>
        <h2 class="gb-h">{kop}</h2>
        {intro === null ? (
          <p class="gb-intro">Nog <span data-dagen>{dagen}</span> dagen. Als je iets kwijt wil voordat ik vertrek, dan kan dat hier. Ik lees alles.</p>
        ) : (
          <p class="gb-intro">{intro}</p>
        )}
        <ul class="gb-sug">
          {suggesties.map(s => (
            <li><button type="button" class="mono" data-sug={s}>{s}</button></li>
          ))}
        </ul>
      </div>

      <div class="gb-rechts">
        {uitgelicht && (
          <figure class="gb-uit" data-uitgelicht data-totaal-start={gastenboek.totaal}>
            <blockquote class="gb-uit-t" data-uit-tekst set:html={uitgelicht.bericht} />
            <figcaption class="gb-uit-b">
              <span class="gb-uit-n" data-uit-naam set:html={uitgelicht.naam} />
              <span class="gb-uit-d mono" data-uit-datum>{fmtNL(uitgelicht.datum)}</span>
            </figcaption>
            <a class="gb-uit-a mono" href="/gastenboek/">Lees alle <span data-uit-aantal>{gastenboek.totaal}</span> berichten</a>
          </figure>
        )}

        <form class="gb-form" novalidate data-max={MAX}>
          <label class="gb-veld">
            <span class="mono">Naam</span>
            <input type="text" name="naam" maxlength="40" required autocomplete="name" />
          </label>
          <label class="gb-veld">
            <span class="mono">Bericht</span>
            <textarea name="bericht" rows="5" required></textarea>
            <span class="gb-teller mono" data-teller>0 / {MAX}</span>
          </label>
          <div class="gb-honing" aria-hidden="true">
            <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <input type="hidden" name="t" />
          <input type="hidden" name="sig" />
          <button class="btn btn-f" type="submit">Achterlaten</button>
          <p class="gb-melding mono" role="status"></p>
        </form>

        <div class="gb-dank" hidden>
          <h3 class="gb-dank-h"></h3>
          <p class="gb-dank-t">Ik lees alles, ook als ik niet meteen reageer. Hopelijk houden we contact, gewoon zoals we dat altijd deden of via de socials hieronder. Dan neem ik je mee.</p>
          <div class="gb-dank-k">
            <button type="button" class="gb-knopje mono" data-opnieuw>Nog een bericht</button>
            <button type="button" class="gb-knopje mono" data-deel>Deel de site</button>
          </div>
        </div>
      </div>
    </div>

    <p class="gb-totaal mono rv" data-totaal hidden></p>
    <div class="gb-lijst rv"></div>
    <div class="gb-meer-wrap rv">
      {toon
        ? <a class="gb-alle mono" href="/gastenboek/">Lees alle <span data-uit-aantal>{gastenboek?.totaal ?? ''}</span> berichten</a>
        : <button type="button" class="gb-meer mono" data-meer hidden>Laat meer zien</button>}
    </div>
  </div>
</section>

<script>
  const api = '/api/gastenboek.php';
  // data-toon staat alleen op de homepage; daar is de lijst kort en komt
  // er geen knop onder, maar de link naar /gastenboek/.
  const blok = document.querySelector('#gastenboek');
  const TOON = Number(blok?.dataset.toon) || 0;
  const PER = TOON || 10;

  const form = document.querySelector('.gb-form');
  const MAX = Number(form.dataset.max);
  const lijst = document.querySelector('.gb-lijst');
  const melding = form.querySelector('.gb-melding');
  const knop = form.querySelector('button[type="submit"]');
  const tekstveld = form.elements.bericht;
  const teller = document.querySelector('[data-teller]');
  const dank = document.querySelector('.gb-dank');
  const totaalEl = document.querySelector('[data-totaal]');
  const meerKnop = document.querySelector('[data-meer]');

  let geladen = 0;

  document.querySelectorAll('[data-sug]').forEach(b => b.addEventListener('click', () => {
    tekstveld.placeholder = b.dataset.sug;
    tekstveld.focus();
  }));

  // teller onder het berichtveld
  const telBij = () => {
    const n = tekstveld.value.length;
    teller.textContent = `${n} / ${MAX}`;
    teller.classList.toggle('bijna', n >= MAX - 200 && n <= MAX);
    teller.classList.toggle('over', n > MAX);
    knop.disabled = n > MAX;
  };
  tekstveld.addEventListener('input', telBij);
  telBij();

  const fmt = (iso) => {
    const d = new Date(iso);
    return isNaN(d) ? '' : new Intl.DateTimeFormat('nl-NL', { day: '2-digit', month: '2-digit', year: 'numeric' })
      .format(d).replaceAll('-', '.');
  };

  // Het aantal staat op drie plekken: in de hero, onder het uitgelichte
  // bericht en boven de lijst. De waarde uit de build blijft staan tot
  // een van de verzoeken hieronder een nieuw totaal meebrengt; komt dat
  // er niet, dan verandert er niets.
  function zetAantal(totaal) {
    if (!Number.isFinite(totaal) || totaal < 1) return;
    document.querySelectorAll('[data-hero-aantal],[data-uit-aantal]')
      .forEach(el => { el.textContent = totaal; });
    const woord = totaal === 1 ? 'bericht' : 'berichten';
    document.querySelectorAll('[data-hero-aantal]').forEach(el => {
      if (el.nextSibling) el.nextSibling.textContent = ` ${woord}`;
    });
  }

  async function haalStart() {
    try {
      const r = await fetch(api + '?start=1');
      const d = await r.json();
      form.elements.t.value = d.t;
      form.elements.sig.value = d.sig;
    } catch { /* zonder tijdstempel weigert de server, meer hoeft niet */ }
  }

  // De link Lees verder staat er meteen in, op de homepage waar de CSS
  // afkapt. Dat is met opzet de veilige stand: zou hij pas door een
  // scriptje worden toegevoegd en dat scriptje faalt, dan staat de tekst
  // wél afgekapt maar kan niemand verder lezen. Nu haalt haalWegWaarHeel()
  // hem juist weg bij de berichten die helemaal passen.
  const kaartje = (b) => `
    <article class="gb-item">
      <p class="gb-kop"><span class="gb-naam">${b.naam}</span><span class="gb-datum mono">${fmt(b.datum)}</span></p>
      <p class="gb-tekst">${b.bericht}</p>
      ${TOON ? '<a class="gb-verder mono" href="/gastenboek/">Lees verder</a>' : ''}
    </article>`;

  // Op de homepage kapt de CSS lange berichten af op twaalf regels. Of
  // dat echt gebeurd is weet alleen de browser, dus vergelijken we
  // scrollHeight met clientHeight en halen we de link weg bij alles wat
  // gewoon past. De marge van 2px vangt afrondingsverschillen op.
  function haalWegWaarHeel() {
    lijst.querySelectorAll('.gb-item').forEach(item => {
      const t = item.querySelector('.gb-tekst');
      const a = item.querySelector('.gb-verder');
      if (!t || !a) return;
      if (t.scrollHeight <= t.clientHeight + 2) a.remove();
    });
  }

  async function haalBerichten(offset = 0) {
    try {
      const r = await fetch(`${api}?offset=${offset}&limiet=${PER}`);
      const d = await r.json();
      const items = d.berichten || [];

      if (offset === 0) {
        geladen = 0;
        if (items.length === 0) {
          lijst.innerHTML = '<p class="gb-leeg">Nog niemand geweest.<br>Jij mag de eerste zijn.</p>';
          totaalEl.hidden = true;
          if (meerKnop) meerKnop.hidden = true;
          return;
        }
        lijst.innerHTML = '';
      }

      lijst.insertAdjacentHTML('beforeend', items.map(kaartje).join(''));
      geladen += items.length;
      if (TOON) haalWegWaarHeel();

      totaalEl.hidden = false;
      totaalEl.textContent = d.totaal === 1 ? '1 bericht' : `${d.totaal} berichten`;
      if (meerKnop) meerKnop.hidden = !d.meer;
      zetAantal(d.totaal);
    } catch {
      if (offset === 0) {
        lijst.innerHTML = '<p class="gb-leeg">De berichten laden nu even niet mee.<br>Kom later nog eens terug.</p>';
      }
    }
  }

  meerKnop?.addEventListener('click', () => haalBerichten(geladen));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    melding.textContent = '';
    knop.disabled = true;
    const naam = form.elements.naam.value.trim();
    try {
      const r = await fetch(api, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          naam,
          bericht: form.elements.bericht.value,
          website: form.elements.website.value,
          t: Number(form.elements.t.value),
          sig: form.elements.sig.value
        })
      });
      const d = await r.json();
      if (r.ok && d.ok) {
        dank.querySelector('.gb-dank-h').textContent =
          naam ? `Wat lief, ${naam}. Dank je wel.` : 'Wat lief. Dank je wel.';
        form.hidden = true;
        dank.hidden = false;
        form.elements.naam.value = '';
        form.elements.bericht.value = '';
        telBij();
        await haalBerichten(0);
      } else {
        melding.textContent = d.fout || 'Er ging iets mis. Probeer het later nog eens.';
      }
    } catch {
      melding.textContent = 'Er ging iets mis. Probeer het later nog eens.';
    } finally {
      telBij();
      haalStart();
    }
  });

  dank.querySelector('[data-opnieuw]').addEventListener('click', () => {
    dank.hidden = true;
    form.hidden = false;
    form.elements.naam.focus();
  });

  dank.querySelector('[data-deel]').addEventListener('click', async (e) => {
    const url = location.origin + '/gastenboek/';
    const b = e.currentTarget;
    if (navigator.share) {
      try { await navigator.share({ title: 'Voordat ik ga', url }); return; } catch { /* afgebroken */ }
    }
    try {
      await navigator.clipboard.writeText(url);
      const was = b.textContent;
      b.textContent = 'Gekopieerd';
      setTimeout(() => { b.textContent = was; }, 1800);
    } catch { /* zonder klembord doet de knop niks */ }
  });

  // het uitgelichte bericht wisselt bij elke weergave: één klein
  // verzoek met een willekeurige plek uit de hele stapel
  async function wisselUitgelicht() {
    const blok = document.querySelector('[data-uitgelicht]');
    if (!blok) return;
    const totaal = Number(blok.dataset.totaalStart) || 0;
    if (totaal < 2) return;
    try {
      const plek = Math.floor(Math.random() * totaal);
      const r = await fetch(`${api}?offset=${plek}&limiet=1`);
      const d = await r.json();
      const b = d.berichten?.[0];
      if (!b) return;
      blok.querySelector('[data-uit-tekst]').innerHTML = b.bericht;
      blok.querySelector('[data-uit-naam]').innerHTML = b.naam;
      blok.querySelector('[data-uit-datum]').textContent = fmt(b.datum);
      zetAantal(d.totaal);
    } catch { /* dan blijft het bericht van de build staan */ }
  }

  haalStart();
  haalBerichten(0);
  wisselUitgelicht();
</script>
