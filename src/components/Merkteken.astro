  <circle cx="60" cy="34" r="12" fill={sun} />
  <path d="M6 88 L30 66 L44 78 L62 50 L78 70 L94 58 L114 82" fill="none"
    stroke={line} stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
</svg>
