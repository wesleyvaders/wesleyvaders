---
// De lijn in de hero. Het gouden punt staat op de gereden fractie van de
// rit, niet op nul: dat komt uit afstand in site.js. Bij aankomst staat
// gereden gelijk aan totaal en staat het punt vanzelf op 100%.
import { afstand } from '../data/site.js';

const {
  van = 'Monster \u00b7 20.09.2026',
  naar = 'Alfaz del Pi \u00b7 ?'
} = Astro.props;

const deel = Math.min(1, Math.max(0, (afstand.gereden ?? 0) / (afstand.totaal || 1)));
const procent = Math.round(deel * 100);

// Het label staat gecentreerd onder het punt, maar aan de uiteinden
// loopt het dan half van het scherm af. Bij aankomst staat het punt op
// 100% en verdween op 390 breed de helft van Alfaz del Pi. Dichtbij een
// rand schuift het label dus naar binnen.
const kant = procent >= 88 ? ' rlijn-nu-r' : procent <= 12 ? ' rlijn-nu-l' : '';
---
<div class="rlijn">
  <div class="rlijn-l"></div>
  <div class="rlijn-p" style={`left:${procent}%`}></div>
  {afstand.waar && (
    <p class={`rlijn-nu mono${kant}`} style={`left:${procent}%`}>{afstand.waar}</p>
  )}
  <div class="rlijn-m mono"><span>{van}</span><span>{naar}</span></div>
</div>
