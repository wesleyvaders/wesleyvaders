---
// De lijn in de hero. Het gouden punt staat op de gereden fractie van de
// rit; dat komt uit afstand in site.js. Bij aankomst staat gereden
// gelijk aan totaal en staat het punt op 100%.
//
// Het eindpunt rechts en het gouden label noemden allebei de plaats van
// nu. Zodra hij aankwam stond Alfaz del Pi er dus twee keer, op 390 bijna
// over elkaar heen. Nu valt het losse label weg zodra het punt het einde
// van de lijn raakt, en neemt het eindpunt de datum over.
import { afstand, vertrek, aankomst } from '../data/site.js';

const fmt = (iso) => {
  const [j, m, d] = iso.split('-');
  return `${d}.${m}.${j}`;
};

const {
  van = `Monster · ${fmt(vertrek)}`,
  naar = `Alfaz del Pi · ${aankomst ? fmt(aankomst) : '?'}`
} = Astro.props;

const deel = Math.min(1, Math.max(0, (afstand.gereden ?? 0) / (afstand.totaal || 1)));
const procent = Math.round(deel * 100);

// Dicht bij een uiteinde schuift het label naar binnen, anders loopt het
// half van het scherm af. Raakt het punt het einde, dan staat de plaats
// al in het eindpunt eronder en hoeft het label er niet meer bij.
const bijEinde = procent >= 97;
const kant = procent >= 88 ? ' rlijn-nu-r' : procent <= 12 ? ' rlijn-nu-l' : '';
---
<div class="rlijn">
  <div class="rlijn-l"></div>
  <div class="rlijn-p" style={`left:${procent}%`}></div>
  {afstand.waar && !bijEinde && (
    <p class={`rlijn-nu mono${kant}`} style={`left:${procent}%`}>{afstand.waar}</p>
  )}
  <div class="rlijn-m mono"><span>{van}</span><span>{naar}</span></div>
</div>
