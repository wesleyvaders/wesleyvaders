---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import Cookiebanner from '../components/Cookiebanner.astro';
import { site, vertrek } from '../data/site.js';

const {
  titel,
  omschrijving = site.omschrijving,
  og = '/og/transporter.jpg',
  ogAlt = 'De bus van Wesley bij de bergen in Spanje',
  type = 'website',
  schema = null,
  navDonker = false,
  preloadBeeld = null,
  noindex = false
} = Astro.props;

const volledigeTitel = titel ? `${titel} · ${site.naam}` : `${site.naam} · ${site.serie}`;
const url = new URL(Astro.url.pathname, site.domein).href;

const persoon = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.naam,
  url: site.domein,
  description: site.omschrijving,
  sameAs: [
    'https://www.youtube.com/@wesleyvaders9102',
    'https://www.instagram.com/wesleyvaders/',
    'https://www.tiktok.com/@wesleyvaders',
    'https://www.facebook.com/wesleyvaders'
  ]
};
---
<!doctype html>
<html lang="nl" data-vertrek={vertrek}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <title>{volledigeTitel}</title>
  <meta name="description" content={omschrijving} />
  <link rel="canonical" href={url} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:type" content={type} />
  <meta property="og:title" content={volledigeTitel} />
  <meta property="og:description" content={omschrijving} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={new URL(og, site.domein).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogAlt} />
  <meta property="og:locale" content="nl_NL" />
  <meta property="og:site_name" content={site.naam} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={new URL(og, site.domein).href} />
  <meta name="theme-color" content="#141412" />

  {preloadBeeld && (
    <link rel="preload" as="image" href={preloadBeeld.src}
      imagesrcset={preloadBeeld.srcSet.attribute} imagesizes="100vw" />
  )}

  <!-- alleen wat boven de vouw staat; de rest komt via de CSS mee -->
  <link rel="preload" as="font" type="font/woff2" crossorigin
    href="/fonts/instrument-serif-latin.woff2" />
  <link rel="preload" as="font" type="font/woff2" crossorigin
    href="/fonts/instrument-sans-latin.woff2" />

  <script type="application/ld+json" set:html={JSON.stringify(persoon)} />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

  <Analytics />
</head>
<body>
  <a class="skip" href="#hoofd">Naar de inhoud</a>
  <div class="voortgang" aria-hidden="true"></div>
  <Nav donker={navDonker} />
  <main id="hoofd">
    <slot />
  </main>
  <Footer />
  <Cookiebanner />

  <script>
    const io = new IntersectionObserver(
      (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
      { threshold: 0, rootMargin: '0px 0px -5% 0px' }
    );
    document.querySelectorAll('.rv').forEach(el => io.observe(el));

    // De aftelling staat op meerdere pagina's en wordt bij de build
    // berekend. Zonder deze regels blijft hij staan op de dag van de
    // laatste deploy. Daarom rekent de browser hem overal zelf bij.
    const doel = new Date(document.documentElement.dataset.vertrek + 'T00:00:00');
    const vandaag0 = new Date(); vandaag0.setHours(0, 0, 0, 0);
    const dagenOver = Math.round((doel - vandaag0) / 86400000);

    document.querySelectorAll('[data-dagen]').forEach(el => {
      el.textContent = String(Math.max(0, dagenOver));
    });
    document.querySelectorAll('[data-aftel]').forEach(el => {
      el.textContent = dagenOver > 0 ? `Nog ${dagenOver} dagen`
        : dagenOver === 0 ? 'Vandaag' : `${-dagenOver} dagen in Spanje`;
    });

    // hetzelfde voor de plekken die een aantal weken noemen
    const WOORD = ['nul', 'één', 'twee', 'drie', 'vier', 'vijf', 'zes', 'zeven',
      'acht', 'negen', 'tien', 'elf', 'twaalf', 'dertien', 'veertien'];
    const wekenZin = (d) => {
      if (d < 0) return 'Onderweg';
      if (d === 0) return 'Vandaag';
      if (d === 1) return 'Nog één dag';
      if (d < 14) return `Nog ${WOORD[d] ?? d} dagen`;
      const w = Math.round(d / 7);
      const woord = WOORD[w] ?? String(w);
      return `${woord.charAt(0).toUpperCase()}${woord.slice(1)} weken`;
    };
    document.querySelectorAll('[data-weken]').forEach(el => {
      const zin = wekenZin(dagenOver);
      el.textContent = el.hasAttribute('data-kort')
        ? zin.charAt(0).toLowerCase() + zin.slice(1) : zin;
    });
    if (dagenOver <= 0) {
      document.querySelectorAll('[data-tot-vertrek]').forEach(el => { el.hidden = true; });
    }

    // sticky nav: achtergrond na 40px, en op donkere hero's pas omslaan
    // naar inkt zodra de hero uit beeld is
    const nav = document.querySelector('.nav');
    const voortgang = document.querySelector('.voortgang');
    const hero = document.querySelector('.hero, .opening');

    const opScroll = () => {
      nav.dataset.vast = String(scrollY > 40);
      const h = document.documentElement;
      const p = h.scrollTop / (h.scrollHeight - h.clientHeight || 1);
      voortgang.style.width = (p * 100) + '%';
    };
    addEventListener('scroll', opScroll, { passive: true });
    opScroll();

    if (hero) {
      new IntersectionObserver(([e]) => {
        nav.dataset.hero = String(e.isIntersecting);
        nav.classList.toggle('nav-donker', e.isIntersecting);
        nav.classList.toggle('nav-licht', !e.isIntersecting);
      }, { rootMargin: '-70px 0px 0px 0px' }).observe(hero);
    } else {
      nav.dataset.hero = 'false';
    }
  </script>
</body>
</html>
