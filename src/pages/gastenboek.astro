---
import Base from '../layouts/Base.astro';
import Gastenboek from '../components/Gastenboek.astro';
import { vertrek, aankomst } from '../data/site.js';
import { dagenTeller, fase, kies } from '../lib/tijd.js';

const teller = dagenTeller(vertrek, aankomst);
const omschrijving = kies(fase(vertrek, aankomst), {
  aftellen: 'Laat iets achter voordat ik naar Spanje vertrek. Een herinnering, een goede raad, of iets wat ik daar moet doen.',
  onderweg: 'Laat iets achter nu ik onderweg ben naar Spanje. Een herinnering, een goede raad, of iets wat ik daar moet doen.',
  aangekomen: 'Laat iets achter nu ik in Spanje zit. Een herinnering, een goede raad, of iets wat ik hier moet doen.'
});
---

<Base
  titel="Gastenboek"
  omschrijving={omschrijving}
  og="/og/gastenboek.jpg"
  ogAlt="Het gastenboek van wesleyvaders.nl"
>
  <header class="paper" style="padding:clamp(9rem,16vw,13rem) 0 clamp(1rem,2vw,2rem)">
    <div class="grain"></div>
    <div class="wrap">
      <p class="eyebrow" data-reisteller-e>{teller.eyebrow}</p>
      <h1 class="h2" style="margin-top:.7rem">Gastenboek</h1>
    </div>
  </header>

  <Gastenboek />
</Base>
