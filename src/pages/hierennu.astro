---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { vertrek } from '../data/site.js';

const PER = 12;
const GRENS = 30; // daarboven echte paginering

const alle = (await getCollection('hierennu', e => !e.data.concept))
  .sort((a, b) => b.data.nummer - a.data.nummer);

const paginering = alle.length > GRENS;
const zichtbaar = paginering ? alle.slice(0, PER) : alle;
const paginas = paginering ? Math.ceil(alle.length / PER) : 1;

const berichten = await Promise.all(
  zichtbaar.map(async (b) => ({ data: b.data, Content: (await render(b)).Content }))
);

const fmt = (d) => new Intl.DateTimeFormat('nl-NL', { day: '2-digit', month: '2-digit', year: 'numeric' })
  .format(d).replaceAll('-', '.');

const vandaag = new Date(); vandaag.setHours(0, 0, 0, 0);
const dagen = Math.round((new Date(vertrek + 'T00:00:00') - vandaag) / 86400000);
---
<Base titel="Hier en nu" omschrijving="Korte berichten onderweg. Wat er tussendoor gebeurt.">
  <section class="paper sec" style="padding-top:clamp(9rem,16vw,13rem)">
    <div class="grain"></div>
    <div class="wrap">
      <p class="eyebrow">Even in het hier en nu</p>
      <h1 class="h2" style="margin:.7rem 0 3rem">Korte berichten</h1>

      {berichten.length === 0 ? (
        <p style="color:rgba(20,20,18,.6);line-height:1.7">Nog niks te melden.</p>
      ) : (
        <div class="kaarten" data-lijst data-per={PER}>
          {berichten.map((b, i) => {
            const Content = b.Content;
            return (
              <article class="kaart" hidden={!paginering && i >= PER}>
                <p class="kaart-m mono">
                  <span>{fmt(b.data.datum)}</span>
                  {b.data.locatie && <><i>/</i><span>{b.data.locatie}</span></>}
                  <i>/</i><span>Nr. {String(b.data.nummer).padStart(3, '0')}</span>
                </p>
                {b.data.titel && <h3>{b.data.titel}</h3>}
                <Content />
              </article>
            );
          })}
        </div>
      )}

      {!paginering && alle.length > PER && (
        <div class="meer-wrap">
          <button type="button" class="meer mono" data-meer>Laat meer zien</button>
        </div>
      )}

      {paginering && paginas > 1 && (
        <nav class="pagina" aria-label="Paginering">
          <span class="pagina-nu mono">Pagina 1 van {paginas}</span>
          <a class="pagina-l mono" href="/hierennu/2/">Volgende</a>
        </nav>
      )}

      {dagen > 0 && (
        <div class="gb-oproep">
          <p>Nog {dagen} dagen tot ik vertrek. Laat iets achter voordat ik ga.</p>
          <a class="btn btn-f" href="/gastenboek/">Naar het gastenboek</a>
        </div>
      )}
    </div>
  </section>
</Base>

<script>
  const knop = document.querySelector('[data-meer]');
  const lijst = document.querySelector('[data-lijst]');
  knop?.addEventListener('click', () => {
    const per = Number(lijst.dataset.per) || 12;
    const verborgen = [...lijst.children].filter(e => e.hidden);
    verborgen.slice(0, per).forEach(e => { e.hidden = false; });
    if (verborgen.length <= per) knop.hidden = true;
  });
</script>
