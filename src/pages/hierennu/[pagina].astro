---
// Pagina 2 en verder, zelfde regel als bij de verhalen.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const PER = 12, GRENS = 30;
  const alle = (await getCollection('hierennu', e => !e.data.concept))
    .sort((a, b) => b.data.nummer - a.data.nummer);
  if (alle.length <= GRENS) return [];
  const paginas = Math.ceil(alle.length / PER);
  return Array.from({ length: paginas - 1 }, (_, i) => {
    const nr = i + 2;
    return {
      params: { pagina: String(nr) },
      props: { nr, paginas, items: alle.slice((nr - 1) * PER, nr * PER) }
    };
  });
}

const { nr, paginas, items } = Astro.props;
const berichten = await Promise.all(
  items.map(async (b) => ({ data: b.data, Content: (await render(b)).Content }))
);
const fmt = (d) => new Intl.DateTimeFormat('nl-NL', { day: '2-digit', month: '2-digit', year: 'numeric' })
  .format(d).replaceAll('-', '.');
const vorige = nr === 2 ? '/hierennu/' : `/hierennu/${nr - 1}/`;
---
<Base titel={`Hier en nu, pagina ${nr}`} omschrijving="Korte berichten onderweg. Wat er tussendoor gebeurt.">
  <section class="paper sec" style="padding-top:clamp(9rem,16vw,13rem)">
    <div class="grain"></div>
    <div class="wrap">
      <p class="eyebrow">Even in het hier en nu · pagina {nr}</p>
      <h1 class="h2" style="margin:.7rem 0 3rem">Korte berichten</h1>

      <div class="kaarten">
        {berichten.map((b) => {
          const Content = b.Content;
          return (
            <article class="kaart">
              <p class="kaart-m mono">
                <span>{fmt(b.data.datum)}</span>
                {b.data.locatie && <><i>/</i><span>{b.data.locatie}</span></>}
                <i>/</i><span>Nr. {String(b.data.nummer).padStart(3, '0')}</span>
              </p>
              {b.data.titel && <h3>{b.data.titel}</h3>}
              <Content />
            </article>
          );
        })}
      </div>

      <nav class="pagina" aria-label="Paginering">
        <a class="pagina-l mono" href={vorige}>Vorige</a>
        <span class="pagina-nu mono">Pagina {nr} van {paginas}</span>
        {nr < paginas && <a class="pagina-l mono" href={`/hierennu/${nr + 1}/`}>Volgende</a>}
      </nav>
    </div>
  </section>
</Base>
