---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Reacties from '../../components/Reacties.astro';
import { site, vertrek } from '../../data/site.js';

export async function getStaticPaths() {
  const verhalen = (await getCollection('verhalen', e => !e.data.concept))
    .sort((a, b) => a.data.datum - b.data.datum);

  return verhalen.map((v, i) => {
    // het vorige en het volgende verhaal. Ontbreekt er een, dan schuiven
    // we op naar de andere kant, zodat het blok nooit half leeg staat.
    const vorige = verhalen[i - 1];
    const volgende = verhalen[i + 1];
    let leesOok;
    if (vorige && volgende) leesOok = [vorige, volgende];
    else if (volgende) leesOok = [volgende, verhalen[i + 2]];
    else leesOok = [verhalen[i - 2], vorige];
    leesOok = leesOok.filter(Boolean);
    return { params: { slug: v.id }, props: { v, leesOok } };
  });
}

const { v, leesOok } = Astro.props;
const { Content } = await render(v);
const d = v.data;
const fmt = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }).format(d.datum);

// deelplaatje: standaard dat van de hoofdfoto (scripts/og.py), tenzij
// het verhaal er zelf een meekrijgt in de frontmatter
const ogNaam = d.foto ? d.foto.src.split('/').pop().split('.')[0] : null;
const ogPad = d.deelplaatje ? `/og/${d.deelplaatje}` : ogNaam ? `/og/${ogNaam}.jpg` : undefined;
const ogTekst = d.deelplaatjeAlt ?? (ogNaam ? (d.fotoAlt ?? d.titel) : undefined);

const vandaag = new Date(); vandaag.setHours(0, 0, 0, 0);
const dagen = Math.round((new Date(vertrek + 'T00:00:00') - vandaag) / 86400000);

const fmtKort = (d) => new Intl.DateTimeFormat('nl-NL',
  { day: '2-digit', month: '2-digit', year: 'numeric' }).format(d).replaceAll('-', '.');

const deelUrl = new URL(Astro.url.pathname, site.domein).href;
const waHref = `https://wa.me/?text=${encodeURIComponent(`${d.titel} ${deelUrl}`)}`;
const fbHref = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(deelUrl)}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.titel,
  datePublished: d.datum.toISOString(),
  description: d.kort,
  author: { '@type': 'Person', name: site.naam, url: site.domein },
  mainEntityOfPage: new URL(Astro.url.pathname, site.domein).href
};
---
<Base titel={d.titel} omschrijving={d.kort} type="article" schema={schema}
  og={ogPad} ogAlt={ogTekst}>
  <article>
    <header class="paper" style="padding:clamp(9rem,16vw,13rem) 0 clamp(2.5rem,5vw,4rem)">
      <div class="wrap" style="max-width:52rem">
        <p class="mono" style="color:var(--terra);display:flex;gap:1rem;flex-wrap:wrap">
          {d.hoofdstuk && <span>Hoofdstuk {d.hoofdstuk}</span>}
          <span>{fmt}</span>
          {d.locatie && <span>{d.locatie}</span>}
        </p>
        <h1 class="h2" style="margin-top:1.25rem">{d.titel}</h1>
      </div>
    </header>

    {d.foto && (
      <Image src={d.foto} alt={d.fotoAlt ?? d.titel} widths={[900, 1400, 1900]} sizes="100vw"
        style="width:100%;max-height:70svh;object-fit:cover" />
    )}

    <div class="paper sec">
      <div class="wrap">
        <div class="artikel">
          <div data-artikel>
            <Content />
          </div>

          <Reacties bron={`verhaal:${v.id}`} />

          {leesOok.length > 0 && (
            <section class="ook">
              <h2 class="ook-h">Lees ook</h2>
              <div class="ook-lijst">
                {leesOok.map(a => (
                  <a class="ook-item" href={`/verhalen/${a.id}/`}>
                    <span class="ook-f" aria-hidden="true">
                      {a.data.foto && <Image src={a.data.foto} alt="" widths={[300, 600]} sizes="(max-width:700px) 90vw, 22rem" />}
                    </span>
                    <span class="ook-d mono">{fmtKort(a.data.datum)}</span>
                    <span class="ook-t">{a.data.titel}</span>
                    {a.data.kort && <span class="ook-k">{a.data.kort}</span>}
                  </a>
                ))}
              </div>
            </section>
          )}

          <div class="deel">
            <p class="deel-l mono">Delen</p>
            <div class="deel-k">
              <a class="deel-knop mono" href={waHref} target="_blank" rel="noopener">WhatsApp</a>
              <a class="deel-knop mono" href={fbHref} target="_blank" rel="noopener">Facebook</a>
              <button class="deel-knop mono" type="button" data-kopieer data-url={deelUrl}>Link kopiëren</button>
            </div>
          </div>

          {dagen > 0 && (
            <div class="gb-oproep" data-tot-vertrek>
              <p>Nog <span data-dagen>{dagen}</span> dagen tot ik vertrek. Laat iets achter voordat ik ga.</p>
              <a class="btn btn-f" href="/gastenboek/">Naar het gastenboek</a>
            </div>
          )}
        </div>
      </div>
    </div>
  </article>
</Base>

<script>
  const knop = document.querySelector('[data-kopieer]');
  knop?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(knop.dataset.url);
      const was = knop.textContent;
      knop.textContent = 'Gekopieerd';
      setTimeout(() => { knop.textContent = was; }, 1800);
    } catch { /* zonder clipboard-toegang doet de knop gewoon niks */ }
  });
</script>
