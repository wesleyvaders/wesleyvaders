---
// Pagina 2 en verder. Wordt pas gegenereerd zodra er meer dan 30
// verhalen zijn; daaronder past alles op /verhalen/ met een knop.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const PER = 12;
const GRENS = 30;

export async function getStaticPaths() {
  const PER = 12, GRENS = 30;
  const alle = (await getCollection('verhalen', e => !e.data.concept))
    .sort((a, b) => b.data.datum - a.data.datum);
  if (alle.length <= GRENS) return [];
  const paginas = Math.ceil(alle.length / PER);
  return Array.from({ length: paginas - 1 }, (_, i) => {
    const nr = i + 2;
    return {
      params: { pagina: String(nr) },
      props: { nr, paginas, items: alle.slice((nr - 1) * PER, nr * PER) }
    };
  });
}

const { nr, paginas, items } = Astro.props;
const fmt = (d) => new Intl.DateTimeFormat('nl-NL', { day: '2-digit', month: '2-digit', year: 'numeric' })
  .format(d).replaceAll('-', '.');
const vorige = nr === 2 ? '/verhalen/' : `/verhalen/${nr - 1}/`;
---
<Base titel={`Verhalen, pagina ${nr}`} omschrijving="Alles wat er onderweg gebeurt, van de eerste doos tot de laatste steen.">
  <section class="paper sec" style="padding-top:clamp(9rem,16vw,13rem)">
    <div class="grain"></div>
    <div class="wrap">
      <p class="eyebrow">Het archief · pagina {nr}</p>
      <h1 class="h2" style="margin:.7rem 0 3rem">Verhalen</h1>

      <div class="arch-lijst">
        {items.map(v => (
          <a class="arch" href={`/verhalen/${v.id}/`}>
            <span class="arch-f" aria-hidden="true">
              {v.data.foto && <Image src={v.data.foto} alt="" widths={[200, 400]} sizes="7.5rem" />}
            </span>
            <span class="arch-n">{fmt(v.data.datum)}</span>
            <span class="arch-t">{v.data.titel}</span>
            <span class="arch-d">{v.data.kort}</span>
          </a>
        ))}
      </div>

      <nav class="pagina" aria-label="Paginering">
        <a class="pagina-l mono" href={vorige}>Vorige</a>
        <span class="pagina-nu mono">Pagina {nr} van {paginas}</span>
        {nr < paginas && <a class="pagina-l mono" href={`/verhalen/${nr + 1}/`}>Volgende</a>}
      </nav>
    </div>
  </section>
</Base>
