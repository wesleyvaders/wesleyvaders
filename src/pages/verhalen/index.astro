---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const verhalen = (await getCollection('verhalen', e => !e.data.concept))
  .sort((a, b) => b.data.datum - a.data.datum);

const fmt = (d) => new Intl.DateTimeFormat('nl-NL', { day: '2-digit', month: '2-digit', year: 'numeric' })
  .format(d).replaceAll('-', '.');
---
<Base titel="Verhalen" omschrijving="Alles wat er onderweg gebeurt, van de eerste doos tot de laatste steen.">
  <section class="paper sec" style="padding-top:clamp(9rem,16vw,13rem)">
    <div class="grain"></div>
    <div class="wrap">
      <p class="eyebrow">Het archief</p>
      <h1 class="h2" style="margin:.7rem 0 3rem">Verhalen</h1>

      {verhalen.length === 0 ? (
        <div style="border-top:1px solid var(--lijn);padding-top:2.5rem;max-width:40ch">
          <h2 class="h2" style="font-size:clamp(1.75rem,3.4vw,2.5rem)">Nog niks gesloopt hier.</h2>
          <p style="color:rgba(20,20,18,.6);line-height:1.7;margin-top:1rem">Kom later nog eens terug.</p>
        </div>
      ) : (
        <div class="arch-lijst">
          {verhalen.map(v => (
            <a class="arch" href={`/verhalen/${v.id}/`}>
              <span class="arch-f" aria-hidden="true">
                {v.data.foto && <Image src={v.data.foto} alt="" widths={[200, 400]} sizes="7.5rem" />}
              </span>
              <span class="arch-n">{fmt(v.data.datum)}</span>
              <span class="arch-t">{v.data.titel}</span>
              <span class="arch-d">{v.data.kort}</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
