---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { vertrek } from '../../data/site.js';
import { haalAantallen } from '../../lib/gastenboek.js';

const PER = 12;
const GRENS = 30; // daarboven echte paginering, zodat het indexeerbaar blijft

const alle = (await getCollection('verhalen', e => !e.data.concept))
  .sort((a, b) => b.data.datum - a.data.datum);

const paginering = alle.length > GRENS;
const verhalen = paginering ? alle.slice(0, PER) : alle;
const paginas = paginering ? Math.ceil(alle.length / PER) : 1;

const fmt = (d) => new Intl.DateTimeFormat('nl-NL', { day: '2-digit', month: '2-digit', year: 'numeric' })
  .format(d).replaceAll('-', '.');

const vandaag = new Date(); vandaag.setHours(0, 0, 0, 0);
const dagen = Math.round((new Date(vertrek + 'T00:00:00') - vandaag) / 86400000);

// het aantal reacties per verhaal, in één verzoek bij de build
const aantallen = await haalAantallen();
const reacties = (id) => aantallen[`verhaal:${id}`] ?? 0;
---
<Base titel="Verhalen" omschrijving="Alles wat er onderweg gebeurt, van de eerste doos tot de laatste steen.">
  <section class="paper sec" style="padding-top:clamp(9rem,16vw,13rem)">
    <div class="grain"></div>
    <div class="wrap">
      <p class="eyebrow">Het archief</p>
      <h1 class="h2" style="margin:.7rem 0 2.5rem">Verhalen</h1>

      <a class="vast" href="/route/">
        <span class="vast-l mono">De route <i>&middot;</i> vastgezet</span>
        <span class="vast-t">Niet de snelste weg</span>
        <span class="vast-d">Zeven etappes van Monster naar Alfaz del Pi. Ken je een van die plekken? Laat het weten.</span>
      </a>

      {alle.length === 0 ? (
        <div style="border-top:1px solid var(--lijn);padding-top:2.5rem;max-width:40ch">
          <h2 class="h2" style="font-size:clamp(1.75rem,3.4vw,2.5rem)">Nog niks gesloopt hier.</h2>
          <p style="color:rgba(20,20,18,.6);line-height:1.7;margin-top:1rem">Kom later nog eens terug.</p>
        </div>
      ) : (
        <div class="arch-lijst" data-lijst data-per={PER}>
          {verhalen.map((v, i) => (
            <a class="arch" href={`/verhalen/${v.id}/`} hidden={!paginering && i >= PER}>
              <span class="arch-f" aria-hidden="true">
                {v.data.foto && <Image src={v.data.foto} alt="" widths={[200, 400]} sizes="7.5rem" />}
              </span>
              <span class="arch-n">{fmt(v.data.datum)}</span>
              <span class="arch-t">{v.data.titel}</span>
              <span class="arch-d">{v.data.kort}</span>
              {reacties(v.id) > 0 && (
                <span class="arch-r mono">{reacties(v.id)} {reacties(v.id) === 1 ? 'reactie' : 'reacties'}</span>
              )}
            </a>
          ))}
        </div>
      )}

      {!paginering && alle.length > PER && (
        <div class="meer-wrap">
          <button type="button" class="meer mono" data-meer>Laat meer zien</button>
        </div>
      )}

      {paginering && paginas > 1 && (
        <nav class="pagina" aria-label="Paginering">
          <span class="pagina-nu mono">Pagina 1 van {paginas}</span>
          <a class="pagina-l mono" href="/verhalen/2/">Volgende</a>
        </nav>
      )}

      {dagen > 0 && (
        <div class="gb-oproep" data-tot-vertrek>
          <p>Nog <span data-dagen>{dagen}</span> dagen tot ik vertrek. Laat iets achter voordat ik ga.</p>
          <a class="btn btn-f" href="/gastenboek/">Naar het gastenboek</a>
        </div>
      )}
    </div>
  </section>
</Base>

<script>
  const knop = document.querySelector('[data-meer]');
  const lijst = document.querySelector('[data-lijst]');
  knop?.addEventListener('click', () => {
    const per = Number(lijst.dataset.per) || 12;
    const verborgen = [...lijst.children].filter(e => e.hidden);
    verborgen.slice(0, per).forEach(e => { e.hidden = false; });
    if (verborgen.length <= per) knop.hidden = true;
  });
</script>
